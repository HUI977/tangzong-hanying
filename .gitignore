# ── 依赖 ──
node_modules/

# ── 构建产物（构建时重新生成）──
dist/
dist-ssr/
*.local

# ── 日志 ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 环境变量（示例文件除外）──
.env
.env.*
!.env.example

# ── 编辑器 / IDE ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── 系统文件 ──
.DS_Store
Thumbs.db
desktop.ini

# ── 本机工作数据（WorkBuddy 会话数据 / 备份，不入库）──
.workbuddy/
